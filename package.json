{
  "name": "turk-pen",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "api:dev": "npm run dev -w @do/api",
    "api:migrate": "npm run migrate -w @do/api",
    "api:seed": "npm run seed -w @do/api",
    "api:test": "npm run test -w @do/api",
    "web:dev": "npm run dev -w @do/web",
    "web:build": "npm run build -w @do/web"
  },
  "devDependencies": {
    "vite-plugin-pwa": "^1.3.0"
  }
}
