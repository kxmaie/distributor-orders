{
  "name": "turk-pen",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "api:dev": "npm run dev -w @do/api",
    "api:migrate": "npm run migrate -w @do/api",
    "api:seed": "npm run seed -w @do/api",
    "api:test": "npm run test -w @do/api",
    "web:dev": "npm run dev -w @do/web",
    "web:build": "npm run build -w @do/web",
    "build:shared": "npm run build -w @do/shared",
    "api:tenant:provision": "npm run tenant:provision -w @do/api",
    "api:tenant:hash-platform-password": "npm run tenant:hash-platform-password -w @do/api",
    "api:tenant:backup": "npm run tenant:backup -w @do/api",
    "api:tenant:restore": "npm run tenant:restore -w @do/api"
  },
  "devDependencies": {
    "vite-plugin-pwa": "^1.3.0"
  }
}
