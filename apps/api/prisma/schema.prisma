// PostgreSQL schema. JSON payloads stay as serialized text so application behavior
// is consistent across the queue and audit log; checks.sql validates their format.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 BigInt    @id @default(autoincrement())
  username           String    @unique @db.VarChar(60)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  fullName           String    @map("full_name") @db.VarChar(120)
  phone              String?   @db.VarChar(30)
  role               String    @default("distributor") @db.VarChar(20) // distributor | admin | super_admin
  defaultDiscountPct Decimal   @default(0) @map("default_discount_pct") @db.Decimal(5, 2)
  isActive           Boolean   @default(true) @map("is_active")
  failedLogins       Int       @default(0) @map("failed_logins")
  lockedUntil        DateTime? @map("locked_until")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  refreshTokens    RefreshToken[]
  orders           Order[]
  discounts        Discount[]
  passwordRequests PasswordRequest[]

  @@map("users")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  familyId  String    @map("family_id") @db.Char(36)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent") @db.VarChar(500)
  ip        String?   @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(100)
  slug      String     @unique @db.VarChar(120)
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  products  Product[]
  discounts Discount[]

  @@map("categories")
}

model Product {
  id          BigInt  @id @default(autoincrement())
  categoryId  Int     @map("category_id")
  name        String  @db.VarChar(160)
  description String? @db.Text
  imageUrl    String? @map("image_url") @db.VarChar(500)
  basePrice   Decimal @map("base_price") @db.Decimal(12, 2)
  unit        String  @default("piece") @db.VarChar(20) // piece | meter | sqm
  isActive    Boolean @default(true) @map("is_active")

  category  Category         @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variants  ProductVariant[]
  discounts Discount[]

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

model ProductVariant {
  id         BigInt  @id @default(autoincrement())
  productId  BigInt  @map("product_id")
  sku        String  @unique @db.VarChar(60)
  label      String  @db.VarChar(120)
  priceDelta Decimal @default(0) @map("price_delta") @db.Decimal(12, 2)
  isActive   Boolean @default(true) @map("is_active")

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  reservations   Reservation[]

  @@index([productId])
  @@map("product_variants")
}

model Warehouse {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(80)
  isActive Boolean @default(true) @map("is_active")

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  orders         Order[]
  reservations   Reservation[]

  @@map("warehouses")
}

model StockLevel {
  variantId   BigInt @map("variant_id")
  warehouseId Int    @map("warehouse_id")
  onHand      Int    @default(0) @map("on_hand")
  reserved    Int    @default(0)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([variantId, warehouseId])
  @@index([warehouseId])
  @@map("stock_levels")
}

model StockMovement {
  id          BigInt   @id @default(autoincrement())
  variantId   BigInt   @map("variant_id")
  warehouseId Int      @map("warehouse_id")
  type        String   @db.VarChar(20) // receipt | adjustment | reserve | release | ship
  qty         Int
  refType     String?  @map("ref_type") @db.VarChar(50)
  refId       BigInt?  @map("ref_id")
  note        String?  @db.VarChar(500)
  createdBy   BigInt?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([variantId, warehouseId, createdAt])
  @@index([warehouseId])
  @@map("stock_movements")
}

model Reservation {
  id          BigInt   @id @default(autoincrement())
  orderId     BigInt   @map("order_id")
  variantId   BigInt   @map("variant_id")
  warehouseId Int      @map("warehouse_id")
  qty         Int
  status      String   @default("active") @db.VarChar(20) // active | released | fulfilled
  createdAt   DateTime @default(now()) @map("created_at")

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId])
  @@index([variantId])
  @@index([warehouseId])
  @@map("reservations")
}

model Order {
  id            BigInt   @id @default(autoincrement())
  orderNo       String   @unique @map("order_no") @db.VarChar(24)
  userId        BigInt   @map("user_id")
  warehouseId   Int      @map("warehouse_id")
  status        String   @default("new") @db.VarChar(20) // new | confirmed | in_production | ready | delivered | cancelled
  subtotal      Decimal  @db.Decimal(12, 2)
  discountTotal Decimal  @default(0) @map("discount_total") @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  notes         String?  @db.VarChar(1000)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse    Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items        OrderItem[]
  history      OrderStatusHistory[]
  reservations Reservation[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([warehouseId])
  @@map("orders")
}

model OrderItem {
  id           BigInt  @id @default(autoincrement())
  orderId      BigInt  @map("order_id")
  variantId    BigInt  @map("variant_id")
  productName  String  @map("product_name") @db.VarChar(160)
  variantLabel String  @map("variant_label") @db.VarChar(120)
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  discountPct  Decimal @default(0) @map("discount_pct") @db.Decimal(5, 2)
  qty          Int
  lineTotal    Decimal @map("line_total") @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         BigInt   @id @default(autoincrement())
  orderId    BigInt   @map("order_id")
  fromStatus String?  @map("from_status") @db.VarChar(20)
  toStatus   String   @map("to_status") @db.VarChar(20)
  changedBy  BigInt   @map("changed_by")
  note       String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderId])
  @@map("order_status_history")
}

model Discount {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt?   @map("user_id")
  categoryId Int?      @map("category_id")
  productId  BigInt?   @map("product_id")
  pct        Decimal   @db.Decimal(5, 2)
  startsAt   DateTime? @map("starts_at")
  endsAt     DateTime? @map("ends_at")
  isActive   Boolean   @default(true) @map("is_active")

  user     User?     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([categoryId])
  @@index([productId])
  @@map("discounts")
}

model PasswordRequest {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt?   @map("user_id")
  username   String    @db.VarChar(60)
  note       String?   @db.VarChar(500)
  status     String    @default("pending") @db.VarChar(20) // pending | resolved | rejected
  resolvedBy BigInt?   @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, createdAt])
  @@index([userId])
  @@map("password_requests")
}

model NotificationQueue {
  id            BigInt   @id @default(autoincrement())
  channel       String   @db.VarChar(20) // whatsapp | in_app
  recipient     String   @db.VarChar(100)
  payload       String   @db.Text // JSON text (use lib/json.ts)
  status        String   @default("pending") @db.VarChar(20) // pending | sent | failed
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")

  @@index([status, nextAttemptAt])
  @@map("notification_queue")
}

model OrderCounter {
  year   Int @id
  lastNo Int @default(0) @map("last_no")

  @@map("order_counters")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   BigInt?  @map("actor_id")
  action    String   @db.VarChar(60)
  entity    String   @db.VarChar(40)
  entityId  String?  @map("entity_id") @db.VarChar(60)
  meta      String?  @db.Text // JSON text (use lib/json.ts)
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
