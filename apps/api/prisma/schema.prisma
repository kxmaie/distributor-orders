// PostgreSQL schema. JSON payloads stay as serialized text so application behavior
// is consistent across the queue and audit log; checks.sql validates their format.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 BigInt    @id @default(autoincrement())
  username           String    @unique @db.VarChar(60)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  fullName           String    @map("full_name") @db.VarChar(120)
  phone              String?   @db.VarChar(30)
  whatsappOptInAt    DateTime? @map("whatsapp_opt_in_at")
  role               String    @default("distributor") @db.VarChar(20) // distributor | supplier | admin | super_admin
  defaultDiscountPct Decimal   @default(0) @map("default_discount_pct") @db.Decimal(5, 2)
  isActive           Boolean   @default(true) @map("is_active")
  registrationRejectedAt DateTime? @map("registration_rejected_at")
  failedLogins       Int       @default(0) @map("failed_logins")
  lockedUntil        DateTime? @map("locked_until")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  refreshTokens    RefreshToken[]
  orders           Order[]
  discounts        Discount[]
  passwordRequests PasswordRequest[]
  payments         Payment[]

  @@map("users")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  familyId  String    @map("family_id") @db.Char(36)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent") @db.VarChar(500)
  ip        String?   @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(100)
  slug      String     @unique @db.VarChar(120)
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  products  Product[]
  discounts Discount[]

  @@map("categories")
}

model Product {
  id          BigInt  @id @default(autoincrement())
  categoryId  Int     @map("category_id")
  name        String  @db.VarChar(160)
  description String? @db.Text
  imageUrl    String? @map("image_url") @db.VarChar(500)
  basePrice   Decimal @map("base_price") @db.Decimal(12, 2)
  unit        String  @default("piece") @db.VarChar(20) // configured in product_units
  piecesPerUnit Int @default(1) @map("pieces_per_unit")
  unitInfo ProductUnit @relation(fields: [unit], references: [name], onDelete: NoAction, onUpdate: Cascade)
  isActive    Boolean @default(true) @map("is_active")

  category  Category         @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variants  ProductVariant[]
  discounts Discount[]

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

