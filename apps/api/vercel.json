{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "cd ../.. && bash apps/api/scripts/vercel-build.sh",
  "functions": {
    "api/index.js": {
      "includeFiles": "../../packages/shared/dist/index.js"
    },
    "api/whatsapp-notifications.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "whatsapp-notifications",
          "retryAfterSeconds": 60
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
