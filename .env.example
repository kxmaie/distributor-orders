# Copy to apps/api/.env and fill in. Never commit real secrets.
POSTGRES_PASSWORD="CHANGE_ME_Str0ng_Passw0rd"
DATABASE_URL="postgresql://postgres:CHANGE_ME_Str0ng_Passw0rd@localhost:5432/distributor_orders?schema=public"
JWT_SECRET="CHANGE_ME_min_32_chars_random_string_xxxxxxxx"
NODE_ENV="development"
DEMO_MODE="false"
DEMO_DATABASE_URL=""
DEMO_CORS_ORIGIN=""
DEMO_SEED_ADMIN_USERNAME=""
DEMO_SEED_ADMIN_PASSWORD=""
DEMO_SEED_ADMIN_FULLNAME=""
PORT=3000
CORS_ORIGIN="http://localhost:5173"
AI_GATEWAY_API_KEY=""
AI_GATEWAY_MODEL=""
BLOB_READ_WRITE_TOKEN=""

# Used only by `npm run api:seed` (no defaults on purpose)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="CHANGE_ME_at_least_12_chars"
SEED_ADMIN_FULLNAME="Super Admin"

# ── WhatsApp notifications (optional; leave WHATSAPP_API_URL empty to disable sending) ──
# Pick ONE provider. WHATSAPP_PROVIDER is auto-detected from the URL when omitted.
#
# 1) Quick test — CallMeBot (free). Register the admin's number first: https://www.callmebot.com/blog/free-api-whatsapp-messages/
#    The apikey is tied to ONE phone, so only that admin receives messages.
#WHATSAPP_API_URL="https://api.callmebot.com/whatsapp.php"
#WHATSAPP_API_TOKEN="<callmebot apikey>"
#
# 2) Self-hosted — Evolution API
#WHATSAPP_API_URL="https://<host>/message/sendText/<instance>"
#WHATSAPP_API_TOKEN="<apikey>"
#
# 3) Production — Meta WhatsApp Cloud API (outside the 24h window you need an approved template)
#WHATSAPP_API_URL="https://graph.facebook.com/v21.0/<PHONE_NUMBER_ID>/messages"
#WHATSAPP_API_TOKEN="<permanent access token>"
#
#WHATSAPP_PROVIDER=meta|evolution|callmebot
WHATSAPP_DEFAULT_COUNTRY_CODE=20      # 01012345678 -> 201012345678
WHATSAPP_CURRENCY_LABEL="ج.م"

# Multi-customer setup is opt-in. Keep "single" until a control DB and tenant DBs are provisioned.
TENANCY_MODE=single
# Required in multi mode: separate control-plane database and 32-byte hex AES-256 key.
CONTROL_DATABASE_URL=
TENANT_ENCRYPTION_KEY= # 32 random bytes as 64 hex chars; keep unchanged or tenant DB URLs cannot be decrypted
# Owner-only control panel; independent from customer app accounts.
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD_HASH= # generate locally with npm run api:tenant:hash-platform-password
PLATFORM_SESSION_SECRET= # random secret, at least 32 characters
# Local backup/restore utility only. Keep outside Vercel and separate from backup files.
BACKUP_ENCRYPTION_KEY= # 32 random bytes as 64 hex chars; never commit or store beside backups
BACKUP_DIRECTORY=backups/tenants
# Tenant slug sent by this frontend when TENANCY_MODE=multi.
VITE_TENANT_SLUG=
